# Host-side networking for docker-compose. Normally written by scripts/deploy.sh
# (`npm run deploy`), but you can copy this to `.env` and edit by hand.
#
# Only networking lives here — IMAP/AI credentials are entered in the browser UI
# and never touch the server, so there are no secrets to set.

# Which host interface docker publishes the port on (this is what gates access):
#   127.0.0.1   only this machine (default; safest)
#   100.x.y.z   your Tailscale IP -> reachable ONLY from your tailnet (`tailscale ip -4`)
#   0.0.0.0     every interface -> the whole LAN can reach it (use with care)
AURORA_BIND_IP=127.0.0.1

# Host port to publish (container always listens on 5174 internally).
AURORA_HOST_PORT=5174
